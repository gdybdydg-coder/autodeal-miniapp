# Set these in the hosting service's secret/environment settings, never GitHub.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Keep false until real source, user consent and a controlled delivery test exist.
DELIVERY_ENABLED=false
SOURCE_READY=false
AUTO_RIA_API_KEY=
# Optional: set ALL three after verifying a purchased provider allowance.
# Omitted means free staging caps: 24/hour, 60/day, 900 cumulative calls.
# Total is an ABSOLUTE ceiling on persisted calls, not a monthly reset.
# RIA_REQUESTS_HOURLY_CAP=24
# RIA_REQUESTS_DAILY_CAP=60
# RIA_REQUESTS_TOTAL_CAP=900
# Raise to 20 after purchasing quota to inspect more potential comparables.
# RIA_COMPARABLE_SCAN_LIMIT=6
# Operator-requested once-only live check; leave unset during normal operation.
# RIA_VALIDATION_RUN_ID=
