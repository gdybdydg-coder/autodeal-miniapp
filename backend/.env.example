# Set these in the hosting service's secret/environment settings, never GitHub.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Keep false until real source, user consent and a controlled delivery test exist.
DELIVERY_ENABLED=false
SOURCE_READY=false
# Explicit one-search pilot on the existing paid API; no extra worker service.
MONITOR_ENABLED=false
# Operator-only recovery of one reported ID through current filters/valuation.
# Empty by default. One durable attempt per ID; never a force-send switch.
RIA_RECOVERY_LISTING_ID=
# Keep disabled: notify on new publications, without revisiting older active ads.
RIA_ACTIVE_WINDOW_ENABLED=false
# Operator-controlled setup: checks bot identity and refuses another webhook URL.
TELEGRAM_CONFIGURE_WEBHOOK=false
# Optional published UI revision: only updates the bot's Mini App launch button.
# Never enables monitoring, webhook registration or messages.
# MINIAPP_RELEASE=20260917-19
AUTO_RIA_API_KEY=
# Paid listing-specific AI range; reuse the existing key and account user_id.
# No comparative-car calls for notifications while this policy is enabled.
AUTO_RIA_USER_ID=
RIA_AI_PRICE_ENABLED=false
# Optional one-off read-only quote, one durable claim per ID. Never sends a card.
RIA_AI_PRICE_PROBE_ID=
# Optional: set ALL three after verifying a purchased provider allowance.
# Omitted means free staging caps: 24/hour, 60/day, 900 cumulative calls.
# Total is an ABSOLUTE ceiling on persisted calls, not a monthly reset.
# RIA_REQUESTS_HOURLY_CAP=24
# RIA_REQUESTS_DAILY_CAP=60
# RIA_REQUESTS_TOTAL_CAP=900
# Raise to 20 after purchasing quota to inspect more potential comparables.
# RIA_COMPARABLE_SCAN_LIMIT=6
# Operator-requested once-only live check; leave unset during normal operation.
# RIA_VALIDATION_RUN_ID=
# RIA_VALIDATION_PROFILE=golf
# Profiles: golf (32 calls); popular-v1 or eligible-v1 (96 total, 32/model).
# eligible-v1 targets undamaged vehicles; it does not enable monitoring/delivery.
